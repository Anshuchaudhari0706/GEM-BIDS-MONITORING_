# ==========================================
# GeMIntel - Environment Variables Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key for Session Authentication
JWT_SECRET=gemintel_jwt_super_secret_key_2026_production_x89a

# Razorpay Payment Gateway Credentials (HMAC Signature Verification)
RAZORPAY_KEY_ID=rzp_test_GeMIntelDemoKey
RAZORPAY_KEY_SECRET=GeMIntelTestSecretKey987654321

# Initial Admin Account Setup (Automatic Seeding on First Boot)
ADMIN_EMAIL=admin@gemintel.com
ADMIN_PASSWORD=admin123

# Database Connection (Optional for PostgreSQL/MySQL deployment)
DATABASE_URL=postgres://gemintel_user:secure_password@localhost:5432/gemintel_db
